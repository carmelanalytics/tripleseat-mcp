{
  "version": 2,
  "installCommand": "npm install && npm run build",
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/api/index.js"
    }
  ],
  "crons": [
    {
      "path": "/agent/cron/poll",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/agent/cron/kb-sync",
      "schedule": "7 * * * *"
    },
    {
      "path": "/agent/cron/digest",
      "schedule": "0 15 * * *"
    }
  ]
}
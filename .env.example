# TripleSeat API Credentials (OAuth 2.0)
# Get these from TripleSeat: Settings > API/Webhooks > OAuth 2.0 Client Applications
TRIPLESEAT_CLIENT_ID=
TRIPLESEAT_CLIENT_SECRET=
TRIPLESEAT_REFRESH_TOKEN=

# Supabase (for API key management + usage tracking)
# Get these from Supabase: Settings > API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_PASSWORD=

# Admin Dashboard Password
ADMIN_PASSWORD=

# Server port (local dev only — Vercel ignores this)
PORT=3000

# ── Inquiry agent (src/agent) ──
# off | shadow | live   (shadow writes replies and logs them but sends nothing)
AGENT_MODE=shadow
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-sonnet-5-5
AGENT_REVIEW_MODEL=claude-opus-5-5
# Microsoft 365 app registration: Mail.ReadWrite + Mail.Send (application), scoped with an
# Exchange application access policy to the mailboxes below only
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
AGENT_MAILBOXES=events@thevillagebigsur.com,patrick@thevillagebigsur.com,info@thevillagebigsur.com
AGENT_SEND_AS=events@thevillagebigsur.com
AGENT_CC=events@thevillagebigsur.com
AGENT_COPY_TO=patrick@thevillagebigsur.com
AGENT_DIGEST_TO=patrick@thevillagebigsur.com,events@thevillagebigsur.com
AGENT_DIGEST_CC=accounting@thevillagebigsur.com
AGENT_ESCALATE_TO=events@thevillagebigsur.com,patrick@thevillagebigsur.com
AGENT_MAX_PER_RUN=6
AGENT_MAX_SENDS_PER_RUN=25
AGENT_MAX_REPLIES_PER_THREAD_PER_DAY=3
# FAQ Google Sheet, shared (Viewer) with the service account's email
AGENT_FAQ_SHEET_ID=
AGENT_FAQ_RANGE=FAQ!A1:G400
GOOGLE_SERVICE_ACCOUNT_JSON=
# Tripleseat ids for leads and the reply log tasks
TRIPLESEAT_LOCATION_ID=
TRIPLESEAT_SITE_ID=
TRIPLESEAT_TASK_TYPE_ID=
TRIPLESEAT_TASK_ASSIGNEE_IDS=
# Vercel cron secret and the public URL used in links
CRON_SECRET=
PUBLIC_BASE_URL=https://tripleseat-mcp-six.vercel.app
